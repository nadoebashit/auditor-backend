# Gemini API
GEMINI_API_KEY=AIzaSyCHPr3VG2eZnU_TBQPlzgiGRS3Gpn2ZYe4
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Gemini Rate Limiting (for free tier)
GEMINI_RPM_LIMIT=10
