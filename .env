# LightRAG Parallelism (reduce to avoid rate limits)
MAX_ASYNC=1
MAX_PARALLEL_INSERT=1
LIGHTRAG_LLM_WORKERS=1
LIGHTRAG_EMBEDDING_WORKERS=2

# Vendored LightRAG (HKU) actual embedding concurrency knobs
EMBEDDING_FUNC_MAX_ASYNC=2
EMBEDDING_BATCH_NUM=1

# Disable AFC (Automatic Function Calling) to reduce API calls
GOOGLE_GENAI_DISABLE_AFC=true

# OpenAI API (fallback, optional)
